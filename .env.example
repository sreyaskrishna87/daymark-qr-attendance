# Port to listen on
PORT=3000

# Secret key used for signing QR code HMAC challenges (keep private in production)
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production

# Unique office ID for multi-branch environments
OFFICE_ID=OFFICE-HQ

# Seconds before each QR code challenge rotates and expires (20 to 30s)
QR_INTERVAL_SEC=25

# Optional custom SQLite database path
# DB_PATH=./attendance.db

