# Port to listen on
PORT=3000

# Required in production. Generate a unique random value and keep it private.
SECRET_KEY=replace-with-a-long-random-secret

# Required in production to protect manager-only API endpoints.
ADMIN_PASSWORD=replace-with-a-strong-manager-password

# Unique office ID for multi-branch environments
OFFICE_ID=OFFICE-HQ

# Seconds before each QR code challenge rotates and expires (20 to 30s)
QR_INTERVAL_SEC=25

# Optional custom SQLite database path
# DB_PATH=./attendance.db

