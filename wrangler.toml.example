name = "daymark-attendance"
main = "worker/index.js"
compatibility_date = "2024-04-01"

[vars]
OFFICE_ID = "OFFICE-HQ"

# Bind your Cloudflare D1 database:
# 1. Create DB: npx wrangler d1 create attendance-db
# 2. Paste database_id below
# 3. Apply schema: npx wrangler d1 execute attendance-db --file=migrations/0001_initial.sql
# 4. Set secrets: npx wrangler secret put ADMIN_PASSWORD  (enter: QeMTpvULQD!jQqBPkB5hSCSx)
#                 npx wrangler secret put SECRET_KEY
# 5. Deploy: npx wrangler deploy

[[d1_databases]]
binding = "DB"
database_name = "attendance-db"
database_id = "YOUR_D1_DATABASE_ID"
